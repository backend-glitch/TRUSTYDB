# Copy this file to .env and supply your local Oracle credentials.
ORACLE_USER=project_user
ORACLE_PASSWORD=replace_with_your_password
ORACLE_CONNECT_STRING=127.0.0.1:1521/FREEPDB1

# Optional: required only when the Oracle Thick client is needed.
# ORACLE_CLIENT_LIB_DIR=/Users/your-user/Downloads/instantclient_23_26

PORT=3000
FRESHNESS_WINDOW_DAYS=30

# "csv" imports source CSVs; "database" evaluates records already present in
# TRUSTYDB's SOURCES, ENTITIES and RECORDS tables.
TRUSTYDB_INPUT_MODE=csv

# Optional CSV location. By default, the bundled TRUSTYDB_SOURCE_*.csv files
# are discovered. For another dataset, use a folder or an explicit CSV list.
# TRUSTYDB_DATA_DIR=/absolute/path/to/my-source-csvs
# TRUSTYDB_SOURCE_FILES=vendor_one.csv,vendor_two.csv,vendor_three.csv
